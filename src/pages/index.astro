---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = (await getCollection('articles'))
  .filter((entry) => entry.data.status === 'publish')
  .sort((a, b) => b.data.published_at.localeCompare(a.data.published_at));

const articlePath = (entry: (typeof articles)[number]) => entry.data.path!;
---
<BaseLayout>
  <h1>Hatchman</h1>
  <ul>
    {articles.map((entry) => (
      <li>
        <time>{entry.data.published_at.slice(0, 10)}</time>
        {' '}
        <a href={articlePath(entry)}>{entry.data.title}</a>
      </li>
    ))}
  </ul>
</BaseLayout>
