---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Hatchman' } = Astro.props;
const fullTitle = title === 'Hatchman' ? title : `${title} | Hatchman`;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a href="/" aria-label="Hatchman">
        <img src="/media/site/logo_title.png" alt="Hatchman" />
      </a>
    </header>
    <main><slot /></main>
  </body>
</html>
