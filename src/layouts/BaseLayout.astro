---
import '../styles/global.css';
interface Props { title?: string; description?: string }
const { title = 'Hatchman', description = '2012〜2020年に書かれた個人ブログの静的アーカイブ' } = Astro.props;
const fullTitle = title === 'Hatchman' ? title : `${title} | Hatchman`;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7781274978364717"
      crossorigin="anonymous"
    ></script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Hatchman</a>
      <nav aria-label="主要ナビゲーション">
        <a href="/archive/">記事一覧</a><a href="/categories/">カテゴリ</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>Hatchman — 2012〜2020年の個人ブログアーカイブ</footer>
  </body>
</html>
